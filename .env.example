# ==============================================================================
# Pan y Queque ERP - Environment Variables Template
# Copy this file to .env and fill in the actual values before running.
# NEVER commit the .env file to the repository.
# ==============================================================================

# PostgreSQL Database Connection (Required)
# The hostname of the database server (use 'db' when running with Docker Compose)
DB_HOST=
# The port PostgreSQL listens on (default: 5432)
DB_PORT=
# The name of the database to connect to
DB_NAME=
# The database user for authentication
DB_USER=
# The database password for authentication
DB_PASS=

# Application Timezone (Optional, default: America/Santiago)
TZ=
