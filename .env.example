# ==============================================================================
# Pan y Queque ERP - Environment Variables Template
# Copy this file to .env and fill in the actual values before running.
# NEVER commit the .env file to the repository.
# ==============================================================================

# MariaDB Database Connection (Required)
# The hostname of the database server (use 'db' with Docker, or '127.0.0.1' locally)
DB_HOST=db
# The port MariaDB listens on (default: 3306)
DB_PORT=3306
# The name of the database to connect to
DB_NAME=panyqueque_erp
# The database user for authentication
DB_USER=erp_user
# The database password for authentication
DB_PASS=erp_password_2026
# Root password for MariaDB container initialisation
MYSQL_ROOT_PASSWORD=erp_root_password_2026

# Application Timezone (Optional, default: America/Santiago)
TZ=America/Santiago
