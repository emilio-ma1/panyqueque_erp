# ==============================================================================
# PAN YQUEQUE - Intranet ERP
# Redirección y Reglas de Reescritura
# ==============================================================================

# Opciones por defecto
DirectoryIndex index.php index.html
Options -Indexes

# Proteger archivos de configuración y sensibles
<FilesMatch "^\.(htaccess|htpasswd|ini|log|env|git)|config\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

